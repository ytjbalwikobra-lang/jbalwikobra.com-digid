# Environment Variables Template
# Copy this file to .env.local and fill in your actual values

# ===== Supabase Configuration =====
# Get these from: https://app.supabase.com/project/YOUR_PROJECT/settings/api
REACT_APP_SUPABASE_URL=https://your-project-ref.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===== Xendit Payment Gateway =====
# Get these from: https://dashboard.xendit.co/settings/developers
XENDIT_SECRET_KEY=xnd_development_or_production_key
XENDIT_WEBHOOK_TOKEN=your-webhook-verification-token

# ===== JWT Configuration =====
# Generate a secure random string for JWT signing
JWT_SECRET=your-secure-random-string-here

# ===== Optional: Local Development =====
# Uncomment these if using local Supabase
# REACT_APP_SUPABASE_URL=http://localhost:54321
# REACT_APP_SUPABASE_ANON_KEY=your-local-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-local-service-role-key

# ===== Node Environment =====
NODE_ENV=development
