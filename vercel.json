{
  "rewrites": [
    {
      "source": "/api/xendit/callback",
      "destination": "/api/xendit/webhook"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/cleanup-auth",
      "schedule": "0 * * * *"
    }
  ],
  "functions": {
    "api/xendit/webhook.ts": {
      "maxDuration": 30
    },
    "api/admin-whatsapp-groups.ts": {
      "maxDuration": 30
    },
    "api/admin-whatsapp.ts": {
      "maxDuration": 30
    },
    "api/cron/cleanup-auth.ts": {
      "maxDuration": 10
    }
  },
  "headers": [
    {
      "source": "/api/xendit/webhook",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
