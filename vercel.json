{
  "rewrites": [
    {
      "source": "/api/xendit/callback",
      "destination": "/api/xendit/webhook"
    },
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/xendit/webhook.ts": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/api/xendit/webhook",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
